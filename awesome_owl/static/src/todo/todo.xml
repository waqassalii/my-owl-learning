<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="awesome_owl.TodoList">
        <div class="row">
            <ul class="list-group">
                <li class="list-group-item text-primary fw-bold">Todo List</li>
                <t t-foreach="state.todos" t-as="todo" t-key="todo.id">
                    <li class="list-group-item"><TodoItem todo="todo"/></li>
                </t>
            </ul>
        </div>
    </t>
</templates>