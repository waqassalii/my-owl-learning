<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div class="container mt-5">
            <div class="row">
                <div class="col text-center border p-3 bg-light">
                    <h2>Total Sum: <t t-esc="state.sum"/></h2>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-6">
                    <Counter title="'Counter A'" onChange.bind="incrementSum"/>
                </div>
                <div class="col-6">
                    <Counter title="'Counter B'" onChange.bind="incrementSum"/>
                </div>
            </div>
        </div>
    </t>

</templates>
