<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div class="container p-3">
           <div class="row">
               <div class="col-4">
                   <div class="row">
                       <div class="border p-3 m-2">
                        <h3>1st Counter</h3>
                           <p>Value: <t t-esc="state.value"/></p>
                           <button class="btn btn-primary " t-on-click="increment">Add</button>
                           <button class="btn btn-primary m-1" t-on-click="decrement">Subtract</button>
                        </div>
                   </div>
               </div>
               <div class="col-4"/>
               <div class="col-4"/>
           </div>
        </div>
    </t>

</templates>
