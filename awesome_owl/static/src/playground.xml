<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="awesome_owl.Playground">
        <div class="container playground-bg min-vh-100 d-flex flex-column align-items-center justify-content-center">
            <div class="text-center row">
                <h2 class="mb-5 fw-bold text-white" style="letter-spacing: 4px; font-size: 2.5rem; text-shadow: 0 2px 15px rgba(0,0,0,0.3);">
                    ✦ Counter Studio ✦
                </h2>
                <div class="d-flex flex-wrap gap-5 justify-content-center">
                    <Counter/>
                    <Counter/>
                </div>
            </div>
            <div class="row ">
                <div class="col-12 mt-5 d-flex flex-wrap gap-2 justify-content-center">
                    <Card title="'Tesla Model S 1'" description="'Electric car with 670 hp , static props , no dynamic props'"/>
                    <Card title="'Tesla Model S 2'" description="'Electric car with 670 hp , static props , no dynamic props'"/>
                    <Card title="'Tesla Model S 3'" description="'Electric car with 670 hp , static props , no dynamic props'"/>
                </div>
            </div>
            <div class="row ">
                <div class="col-12 mt-5 d-flex flex-wrap gap-2 justify-content-center">
                    <CardDynamic t-props="carData"/>
                    <CardDynamic title="carData.title" description="carData.description" price="carData.price" imageUrl="carData.imageUrl" isPopular="carData.isPopular" year="carData.year"/>
                    <CardDynamic title="carData.title" description="carData.description" price="carData.price" imageUrl="carData.imageUrl" isPopular="carData.isPopular" year="carData.year"/>
                </div>
            </div>
            <div class="row ">
                <div class="col-12 mt-5 d-flex flex-wrap gap-2 justify-content-center">
                    <CardDynamic t-props="carData2"/>
                    <CardDynamic t-props="carData2"/>
                    <CardDynamic title="carData2.title" description="carData2.description" price="carData2.price" imageUrl="carData2.imageUrl" isPopular="carData2.isPopular" year="carData2.year"/>
                </div>
            </div>
        </div>
    </t>
</templates>